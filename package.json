{
  "name": "tokenarg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "node scripts/vercel-build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "setup": "npm --prefix blockchain install",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "docs:generate": "python3 scripts/generate-sample-docs.py",
    "contracts:test": "npm --prefix blockchain test",
    "chain:node": "npm --prefix blockchain run node",
    "chain:deploy:local": "npm --prefix blockchain run deploy:local",
    "chain:deploy:amoy": "npm --prefix blockchain run deploy:amoy",
    "chain:simulate": "npm --prefix blockchain run simulate:local",
    "chain:sync": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-chain.ts",
    "abis": "npm --prefix blockchain run export-abis",
    "demo:local": "npm run chain:deploy:local && npm run chain:simulate && npm run chain:sync",
    "smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-test.ts",
    "test:e2e": "node e2e/onboarding.mjs && node e2e/investor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.2",
    "wagmi": "^2.19.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
