# Plantilla de .env. La forma rápida: `npm run setup:env` lo copia y completa los secretos.
# El resto de los valores funcionan tal cual para el entorno local (docker compose + nodo de Hardhat).

# --- Base de datos -------------------------------------------------------------------------
DATABASE_URL="postgresql://tokenarg:tokenarg@localhost:5432/tokenarg?schema=public"
# Con un pooler (Neon, Supabase), las migraciones usan la conexión directa si está definida:
# DATABASE_URL_UNPOOLED=

# --- Redes ---------------------------------------------------------------------------------
# Cada proyecto emite su token en Polygon o en Ethereum. El modo elige qué par de redes usa la app:
#   local   = dos nodos de Hardhat: Polygon local (31337, puerto 8545) y Ethereum local (31338, puerto 8546)
#   testnet = Polygon Amoy (80002) y Ethereum Sepolia (11155111)
#   mainnet = Polygon PoS (137) y Ethereum (1)
NEXT_PUBLIC_NETWORK_MODE=local
# RPC por red para el navegador (opcional; si falta, se usa el público de cada red). Ejemplos:
# NEXT_PUBLIC_RPC_URL_80002=https://polygon-amoy.g.alchemy.com/v2/<clave>
# NEXT_PUBLIC_RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/<clave>
# RPC por red para el servidor (opcional; en producción usá uno privado: Alchemy, Infura, QuickNode):
# RPC_URL_80002=
# RPC_URL_11155111=

# --- Contratos -----------------------------------------------------------------------------
# Las direcciones de cada red salen de blockchain/deployments/<chainId>.json y las carga en la
# base `npm run chain:sync`: no hace falta copiarlas acá.

# Billetera del backend con AGENT_ROLE en el IdentityRegistry de cada red (da de alta a los
# inversores aprobados). Necesita un poco de POL y de ETH para el gas. El valor de ejemplo es
# la cuenta #1 de los nodos locales de Hardhat: su clave es pública, NUNCA la uses en una
# testnet ni en mainnet. En producción, guardala en un KMS.
KYC_AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- KYC -----------------------------------------------------------------------------------
# mock    = proveedor de prueba (se simula el resultado desde /kyc). Nunca funciona en mainnet.
# webhook = proveedor real conectado por el webhook firmado de /api/kyc/webhook.
KYC_PROVIDER=mock
# El proveedor de prueba se apaga solo en builds de producción (`next start`, Vercel). Para una
# demo pública en testnet (Amoy + Sepolia), habilitalo explícitamente con true.
ALLOW_MOCK_KYC=false
# URL a la que se redirige al inversor para la validación (solo KYC_PROVIDER=webhook).
KYC_PROVIDER_START_URL=
# Secreto compartido para firmar los webhooks (HMAC-SHA256). Generalo con: openssl rand -hex 32
KYC_WEBHOOK_SECRET=
# Vigencia de la verificación antes de pedir una actualización del legajo.
KYC_VALIDITY_DAYS=365

# --- Seguridad -----------------------------------------------------------------------------
# Firma de las cookies de sesión. Generalo con: openssl rand -base64 48
SESSION_SECRET=
# Protege /api/cron/sync (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# --- Sitio ----------------------------------------------------------------------------------
# URL pública (metadatos de WalletConnect). En producción: https://tokenarg.net.ar
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Billeteras (opcional) -------------------------------------------------------------------
# Habilita WalletConnect (billeteras móviles). Se obtiene gratis en https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
