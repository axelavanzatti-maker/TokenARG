{
  "name": "@tokenarg/blockchain",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "typecheck": "hardhat build && tsc --noEmit",
    "node": "node scripts/nodes.mjs",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost && hardhat run scripts/deploy.ts --network localhostEthereum",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "simulate:local": "hardhat run scripts/simulate-activity.ts --network localhost && hardhat run scripts/simulate-activity.ts --network localhostEthereum",
    "finalize": "hardhat run scripts/finalize.ts",
    "distribute": "hardhat run scripts/distribute.ts",
    "export-abis": "hardhat run scripts/export-abis.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.5",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.2"
  }
}
